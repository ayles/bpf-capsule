--- |
  source_filename = "arena-spills.ll"
  target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
  target triple = "bpfel"
  
  ; Function Attrs: nounwind
  declare i64 @callee(i64, i64, i64, i64, i64) #0
  
  ; Function Attrs: nounwind
  define i64 @physical(ptr %input, ptr %stack.base) #0 !bpf.capsule.allocation.unit !0 !bpf.capsule.stack.size !1 !bpf.capsule.spill.plan !2 !bpf.capsule.native.stack.budget !10 {
  entry:
    call void asm sideeffect "# bpf_capsule_stack_anchor", "r"(ptr %stack.base)
    %p02 = bitcast ptr %input to ptr
    %v0 = load volatile i64, ptr %p02, align 8
    %p1 = getelementptr i64, ptr %input, i64 1
    %v1 = load volatile i64, ptr %p1, align 8
    %p2 = getelementptr i64, ptr %input, i64 2
    %v2 = load volatile i64, ptr %p2, align 8
    %p3 = getelementptr i64, ptr %input, i64 3
    %v3 = load volatile i64, ptr %p3, align 8
    %p4 = getelementptr i64, ptr %input, i64 4
    %v4 = load volatile i64, ptr %p4, align 8
    %p5 = getelementptr i64, ptr %input, i64 5
    %v5 = load volatile i64, ptr %p5, align 8
    %p6 = getelementptr i64, ptr %input, i64 6
    %v6 = load volatile i64, ptr %p6, align 8
    %p7 = getelementptr i64, ptr %input, i64 7
    %v7 = load volatile i64, ptr %p7, align 8
    %p8 = getelementptr i64, ptr %input, i64 8
    %v8 = load volatile i64, ptr %p8, align 8
    %arena = addrspacecast ptr %input to ptr addrspace(1)
    %arena1 = addrspacecast ptr addrspace(1) %arena to ptr
    %called = call i64 @callee(i64 0, i64 0, i64 0, i64 0, i64 0)
    %held = load volatile i64, ptr %arena1, align 8
    %r0 = add i64 %called, %held
    %r1 = add i64 %r0, %v0
    %r2 = add i64 %r1, %v1
    %r3 = add i64 %r2, %v2
    %r4 = add i64 %r3, %v3
    %r5 = add i64 %r4, %v4
    %r6 = add i64 %r5, %v5
    %r7 = add i64 %r6, %v6
    %r8 = add i64 %r7, %v7
    %r9 = add i64 %r8, %v8
    ret i64 %r9
  }
  
  attributes #0 = { nounwind "target-cpu"="v4" }
  
  !0 = !{i32 0}
  !1 = !{i64 1024}
  !2 = !{!3, !5, !6, !7, !8, !9}
  !3 = !{i32 0, !4}
  !4 = !{i32 0, i64 -1}
  !5 = !{i32 1, !4}
  !6 = !{i32 2, !4}
  !7 = !{i32 3, !4}
  !8 = !{i32 4, !4}
  !9 = !{i32 5, !4}
  !10 = !{i32 512}
...
---
name:            physical
alignment:       8
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
tracksDebugUserValues: true
liveins:
  - { reg: '$r1' }
  - { reg: '$r2' }
frameInfo:
  stackSize:       48
  maxAlignment:    8
  adjustsStack:    true
  hasCalls:        true
  framePointerPolicy: none
  maxCallFrameSize: 0
  isCalleeSavedInfoValid: true
stack:
  - { id: 0, type: spill-slot, offset: -8, size: 8, alignment: 8 }
  - { id: 1, type: spill-slot, offset: -16, size: 8, alignment: 8 }
  - { id: 2, type: spill-slot, offset: -24, size: 8, alignment: 8 }
  - { id: 3, type: spill-slot, offset: -32, size: 8, alignment: 8 }
  - { id: 4, type: spill-slot, offset: -40, size: 8, alignment: 8 }
  - { id: 5, type: spill-slot, offset: -48, size: 8, alignment: 8 }
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    liveins: $r1, $r2
  
    STD $r2, $r10, -16
    INLINEASM &"# bpf_capsule_stack_anchor", sideeffect attdialect, reguse:GPR, killed $r2
    $r2 = ADDR_SPACE_CAST $r1, 1, 0
    $r7 = ADDR_SPACE_CAST killed $r2, 0, 1
    $r6 = LDD $r1, 0 :: (volatile load (s64) from %ir.p02)
    $r9 = LDD $r1, 8 :: (volatile load (s64) from %ir.p1)
    $r8 = LDD $r1, 16 :: (volatile load (s64) from %ir.p2)
    $r2 = LDD $r1, 24 :: (volatile load (s64) from %ir.p3)
    $r3 = LDD $r10, -16
    STD $r2, $r3, 0
    $r2 = LDD $r1, 32 :: (volatile load (s64) from %ir.p4)
    $r3 = LDD $r10, -16
    STD $r2, $r3, 8
    $r2 = LDD $r1, 40 :: (volatile load (s64) from %ir.p5)
    $r3 = LDD $r10, -16
    STD $r2, $r3, 16
    $r2 = LDD $r1, 48 :: (volatile load (s64) from %ir.p6)
    $r3 = LDD $r10, -16
    STD $r2, $r3, 24
    $r2 = LDD $r1, 56 :: (volatile load (s64) from %ir.p7)
    $r3 = LDD $r10, -16
    STD $r2, $r3, 32
    $r1 = LDD killed $r1, 64 :: (volatile load (s64) from %ir.p8)
    STD killed $r1, $r10, -8 :: (store (s64) into %stack.0)
    $r1 = MOV_ri 0
    $r2 = MOV_ri 0
    $r3 = MOV_ri 0
    $r4 = MOV_ri 0
    $r5 = MOV_ri 0
    JAL @callee, csr, implicit $r11, implicit $r1, implicit $r2, implicit killed $r3, implicit killed $r4, implicit killed $r5, implicit-def $r11, implicit-def $r0
    $r1 = LDD killed $r7, 0 :: (volatile load (s64) from %ir.arena1)
    $r0 = ADD_rr killed $r0, killed $r1
    $r0 = ADD_rr killed $r0, killed $r6
    $r0 = ADD_rr killed $r0, killed $r9
    $r0 = ADD_rr killed $r0, killed $r8
    $r1 = LDD $r10, -16
    $r1 = LDD $r1, 0
    $r0 = ADD_rr killed $r0, killed $r1
    $r1 = LDD $r10, -16
    $r1 = LDD $r1, 8
    $r0 = ADD_rr killed $r0, killed $r1
    $r1 = LDD $r10, -16
    $r1 = LDD $r1, 16
    $r0 = ADD_rr killed $r0, killed $r1
    $r1 = LDD $r10, -16
    $r1 = LDD $r1, 24
    $r0 = ADD_rr killed $r0, killed $r1
    $r1 = LDD $r10, -16
    $r1 = LDD $r1, 32
    $r0 = ADD_rr killed $r0, killed $r1
    $r1 = LDD $r10, -8 :: (load (s64) from %stack.0)
    $r0 = ADD_rr killed $r0, killed $r1
    RET implicit $r0
...
