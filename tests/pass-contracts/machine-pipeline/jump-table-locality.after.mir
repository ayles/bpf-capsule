--- |
  source_filename = "machine-jump-table-locality.ll"
  target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
  target triple = "bpfel"
  
  define i32 @root(i32 %index, i32 %value) #0 !bpf.capsule.flatten.root !0 !bpf.capsule.flattened.units !1 {
  entry:
    switch i32 %index, label %bad [
      i32 0, label %call.unit0
      i32 1, label %call.unit1
      i32 2, label %call.unit2
      i32 3, label %call.unit3
      i32 4, label %call.unit4
      i32 5, label %call.unit5
      i32 6, label %call.unit6
      i32 7, label %call.unit7
      i32 8, label %call.unit0
      i32 9, label %call.unit1
      i32 10, label %call.unit2
      i32 11, label %call.unit3
      i32 12, label %call.unit4
      i32 13, label %call.unit5
      i32 14, label %call.unit6
      i32 15, label %call.unit7
      i32 16, label %call.unit0
      i32 17, label %call.unit1
      i32 18, label %call.unit2
      i32 19, label %call.unit3
      i32 20, label %call.unit4
      i32 21, label %call.unit5
      i32 22, label %call.unit6
      i32 23, label %call.unit7
      i32 24, label %call.unit0
      i32 25, label %call.unit1
      i32 26, label %call.unit2
      i32 27, label %call.unit3
      i32 28, label %call.unit4
      i32 29, label %call.unit5
      i32 30, label %call.unit6
      i32 31, label %call.unit7
      i32 32, label %call.unit0
      i32 33, label %call.unit1
      i32 34, label %call.unit2
      i32 35, label %call.unit3
    ]
  
  call.unit0:                                       ; preds = %entry, %entry, %entry, %entry, %entry
    %from.unit0 = call i32 @unit0(i32 %value)
    ret i32 %from.unit0
  
  call.unit1:                                       ; preds = %entry, %entry, %entry, %entry, %entry
    %from.unit1 = call i32 @unit1(i32 %value)
    ret i32 %from.unit1
  
  call.unit2:                                       ; preds = %entry, %entry, %entry, %entry, %entry
    %from.unit2 = call i32 @unit2(i32 %value)
    ret i32 %from.unit2
  
  call.unit3:                                       ; preds = %entry, %entry, %entry, %entry, %entry
    %from.unit3 = call i32 @unit3(i32 %value)
    ret i32 %from.unit3
  
  call.unit4:                                       ; preds = %entry, %entry, %entry, %entry
    %from.unit4 = call i32 @unit4(i32 %value)
    ret i32 %from.unit4
  
  call.unit5:                                       ; preds = %entry, %entry, %entry, %entry
    %from.unit5 = call i32 @unit5(i32 %value)
    ret i32 %from.unit5
  
  call.unit6:                                       ; preds = %entry, %entry, %entry, %entry
    %from.unit6 = call i32 @unit6(i32 %value)
    ret i32 %from.unit6
  
  call.unit7:                                       ; preds = %entry, %entry, %entry, %entry
    %from.unit7 = call i32 @unit7(i32 %value)
    ret i32 %from.unit7
  
  bad:                                              ; preds = %entry
    ret i32 -1
  }
  
  define available_externally i32 @unit0(i32 %value) #0 !bpf.capsule.flatten.unit !0 {
  entry:
    %result = add i32 %value, 10
    ret i32 %result
  }
  
  define available_externally i32 @unit1(i32 %value) #0 !bpf.capsule.flatten.unit !0 {
  entry:
    %result = add i32 %value, 20
    ret i32 %result
  }
  
  define available_externally i32 @unit2(i32 %value) #0 !bpf.capsule.flatten.unit !0 {
  entry:
    %result = add i32 %value, 30
    ret i32 %result
  }
  
  define available_externally i32 @unit3(i32 %value) #0 !bpf.capsule.flatten.unit !0 {
  entry:
    %result = add i32 %value, 40
    ret i32 %result
  }
  
  define available_externally i32 @unit4(i32 %value) #0 !bpf.capsule.flatten.unit !0 {
  entry:
    %result = add i32 %value, 50
    ret i32 %result
  }
  
  define available_externally i32 @unit5(i32 %value) #0 !bpf.capsule.flatten.unit !0 {
  entry:
    %result = add i32 %value, 60
    ret i32 %result
  }
  
  define available_externally i32 @unit6(i32 %value) #0 !bpf.capsule.flatten.unit !0 {
  entry:
    %result = add i32 %value, 70
    ret i32 %result
  }
  
  define available_externally i32 @unit7(i32 %value) #0 !bpf.capsule.flatten.unit !0 {
  entry:
    %result = add i32 %value, 80
    ret i32 %result
  }
  
  attributes #0 = { "target-cpu"="v4" }
  
  !0 = !{i32 0}
  !1 = !{i32 8}
...
---
name:            root
alignment:       8
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
tracksDebugUserValues: true
liveins:
  - { reg: '$w1' }
  - { reg: '$w2' }
frameInfo:
  maxAlignment:    1
  adjustsStack:    true
  hasCalls:        true
  framePointerPolicy: none
  maxCallFrameSize: 0
  isCalleeSavedInfoValid: true
machineFunctionInfo: {}
jumpTable:
  kind:            block-address
  entries:
    - id:              0
      blocks:          [ '%bb.2', '%bb.5', '%bb.3', '%bb.4', '%bb.7', '%bb.8', 
                         '%bb.6', '%bb.9', '%bb.2', '%bb.5', '%bb.3', '%bb.4', 
                         '%bb.7', '%bb.8', '%bb.6', '%bb.9', '%bb.2', '%bb.5', 
                         '%bb.3', '%bb.4', '%bb.7', '%bb.8', '%bb.6', '%bb.9', 
                         '%bb.2', '%bb.5', '%bb.3', '%bb.4', '%bb.7', '%bb.8', 
                         '%bb.6', '%bb.9', '%bb.2', '%bb.5', '%bb.3', '%bb.4' ]
body:             |
  bb.0.entry:
    successors: %bb.10(0x03759f14), %bb.1(0x7c8a60ec)
    liveins: $w1, $w2
  
    JUGT_ri_32 $w1, 35, %bb.10
  
  bb.1.entry:
    successors: %bb.2(0x11c71c72), %bb.5(0x11c71c72), %bb.3(0x11c71c72), %bb.4(0x11c71c72), %bb.7(0x0e38e38e), %bb.8(0x0e38e38e), %bb.6(0x0e38e38e), %bb.9(0x0e38e38e)
    liveins: $w1, $w2
  
    $r1 = MOV_32_64 killed $w1
    $r1 = SLL_ri killed $r1, 3
    $r3 = LD_imm64 %jump-table.0
    $r4 = LD_imm64 %jump-table.0
    $r4 = ADD_rr killed $r4, killed $r1
    $r1 = LDD killed $r4, 0 :: (load (s64) from jump-table)
    $r3 = ADD_rr killed $r3, killed $r1
    JX killed $r3
  
  bb.2.call.unit0:
    liveins: $w2
  
    $w1 = MOV_rr_32 killed $w2
    JMP %bb.11
  
  bb.3.call.unit2:
    liveins: $w2
  
    $w1 = MOV_rr_32 killed $w2
    JMP %bb.12
  
  bb.4.call.unit3:
    liveins: $w2
  
    $w1 = MOV_rr_32 killed $w2
    JMP %bb.13
  
  bb.5.call.unit1:
    liveins: $w2
  
    $w1 = MOV_rr_32 killed $w2
    JMP %bb.14
  
  bb.6.call.unit6:
    liveins: $w2
  
    $w1 = MOV_rr_32 killed $w2
    JMP %bb.15
  
  bb.7.call.unit4:
    liveins: $w2
  
    $w1 = MOV_rr_32 killed $w2
    JMP %bb.16
  
  bb.8.call.unit5:
    liveins: $w2
  
    $w1 = MOV_rr_32 killed $w2
    JMP %bb.17
  
  bb.9.call.unit7:
    liveins: $w2
  
    $w1 = MOV_rr_32 killed $w2
    JMP %bb.18
  
  bb.10.bad:
    $w0 = MOV_ri_32 -1
    RET implicit $w0
  
  bb.11.entry:
    liveins: $w1
  
    $w0 = MOV_rr_32 $w1
    $w0 = ADD_ri_32 killed $w0, 10
    RET implicit $w0
  
  bb.12.entry:
    liveins: $w1
  
    $w0 = MOV_rr_32 $w1
    $w0 = ADD_ri_32 killed $w0, 30
    RET implicit $w0
  
  bb.13.entry:
    liveins: $w1
  
    $w0 = MOV_rr_32 $w1
    $w0 = ADD_ri_32 killed $w0, 40
    RET implicit $w0
  
  bb.14.entry:
    liveins: $w1
  
    $w0 = MOV_rr_32 $w1
    $w0 = ADD_ri_32 killed $w0, 20
    RET implicit $w0
  
  bb.15.entry:
    liveins: $w1
  
    $w0 = MOV_rr_32 $w1
    $w0 = ADD_ri_32 killed $w0, 70
    RET implicit $w0
  
  bb.16.entry:
    liveins: $w1
  
    $w0 = MOV_rr_32 $w1
    $w0 = ADD_ri_32 killed $w0, 50
    RET implicit $w0
  
  bb.17.entry:
    liveins: $w1
  
    $w0 = MOV_rr_32 $w1
    $w0 = ADD_ri_32 killed $w0, 60
    RET implicit $w0
  
  bb.18.entry:
    liveins: $w1
  
    $w0 = MOV_rr_32 $w1
    $w0 = ADD_ri_32 killed $w0, 80
    RET implicit $w0
...
