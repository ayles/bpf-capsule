--- |
  source_filename = "machine-locality.ll"
  target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
  target triple = "bpfel"
  
  define i32 @root(i32 %value) #0 !bpf.capsule.flatten.root !0 !bpf.capsule.flattened.units !1 {
  entry:
    %is.zero = icmp eq i32 %value, 0
    br i1 %is.zero, label %call.unit0, label %call.unit1
  
  call.unit0:                                       ; preds = %entry
    %from.unit0 = call i32 @unit0(i32 %value)
    ret i32 %from.unit0
  
  call.unit1:                                       ; preds = %entry
    %from.unit1 = call i32 @unit1(i32 %value)
    ret i32 %from.unit1
  }
  
  define available_externally i32 @unit0(i32 %value) #0 !bpf.capsule.flatten.unit !0 {
  entry:
    %result = add i32 %value, 10
    ret i32 %result
  }
  
  define available_externally i32 @unit1(i32 %value) #0 !bpf.capsule.flatten.unit !0 {
  entry:
    %result = add i32 %value, 20
    ret i32 %result
  }
  
  attributes #0 = { "target-cpu"="v4" }
  
  !0 = !{i32 0}
  !1 = !{i32 2}
...
---
name:            root
alignment:       8
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
tracksDebugUserValues: true
liveins:
  - { reg: '$w1' }
frameInfo:
  maxAlignment:    1
  adjustsStack:    true
  hasCalls:        true
  framePointerPolicy: none
  maxCallFrameSize: 0
  isCalleeSavedInfoValid: true
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    successors: %bb.1(0x30000000), %bb.2(0x50000000)
    liveins: $w1
  
    JNE_ri_32 $w1, 0, %bb.2
  
  bb.1.call.unit0:
    liveins: $w1
  
    JMP %bb.3
  
  bb.2.call.unit1:
    liveins: $w1
  
    JMP %bb.4
  
  bb.3.entry:
    liveins: $w1
  
    $w0 = MOV_rr_32 $w1
    $w0 = ADD_ri_32 killed $w0, 10
    RET implicit $w0
  
  bb.4.entry:
    liveins: $w1
  
    $w0 = MOV_rr_32 $w1
    $w0 = ADD_ri_32 killed $w0, 20
    RET implicit $w0
...
