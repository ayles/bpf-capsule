--- |
  source_filename = "machine-finalize-v3-cascade.ll"
  target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
  target triple = "bpfel"
  
  define i64 @flattened(i64 %value) #0 !bpf.capsule.flattened.units !0 {
  entry:
    br label %pad0
  
  pad0:                                             ; preds = %entry
    br label %pad1
  
  pad1:                                             ; preds = %pad0
    br label %pad2
  
  pad2:                                             ; preds = %pad1
    br label %pad3
  
  pad3:                                             ; preds = %pad2
    br label %pad4
  
  pad4:                                             ; preds = %pad3
    br label %pad5
  
  pad5:                                             ; preds = %pad4
    br label %pad6
  
  pad6:                                             ; preds = %pad5
    br label %pad7
  
  pad7:                                             ; preds = %pad6
    br label %pad8
  
  pad8:                                             ; preds = %pad7
    br label %pad9
  
  pad9:                                             ; preds = %pad8
    br label %pad10
  
  pad10:                                            ; preds = %pad9
    br label %pad11
  
  pad11:                                            ; preds = %pad10
    br label %pad12
  
  pad12:                                            ; preds = %pad11
    br label %pad13
  
  pad13:                                            ; preds = %pad12
    br label %pad14
  
  pad14:                                            ; preds = %pad13
    br label %pad15
  
  pad15:                                            ; preds = %pad14
    br label %pad16
  
  pad16:                                            ; preds = %pad15
    br label %pad17
  
  pad17:                                            ; preds = %pad16
    br label %pad18
  
  pad18:                                            ; preds = %pad17
    br label %pad19
  
  pad19:                                            ; preds = %pad18
    br label %pad20
  
  pad20:                                            ; preds = %pad19
    br label %pad21
  
  pad21:                                            ; preds = %pad20
    br label %pad22
  
  pad22:                                            ; preds = %pad21
    br label %pad23
  
  pad23:                                            ; preds = %pad22
    br label %pad24
  
  pad24:                                            ; preds = %pad23
    br label %pad25
  
  pad25:                                            ; preds = %pad24
    br label %pad26
  
  pad26:                                            ; preds = %pad25
    br label %pad27
  
  pad27:                                            ; preds = %pad26
    br label %pad28
  
  pad28:                                            ; preds = %pad27
    br label %pad29
  
  pad29:                                            ; preds = %pad28
    br label %pad30
  
  pad30:                                            ; preds = %pad29
    br label %pad31
  
  pad31:                                            ; preds = %pad30
    br label %pad32
  
  pad32:                                            ; preds = %pad31
    br label %pad33
  
  pad33:                                            ; preds = %pad32
    br label %pad34
  
  pad34:                                            ; preds = %pad33
    br label %target
  
  target:                                           ; preds = %pad34
    ret i64 %value
  }
  
  attributes #0 = { "target-cpu"="v3" }
  
  !0 = !{i32 1}
...
---
name:            flattened
alignment:       8
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
liveins:
  - { reg: '$r1' }
frameInfo:
  maxAlignment:    1
  framePointerPolicy: none
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    liveins: $r1
  
    JMP %bb.2
  
  bb.1.pad0:
    liveins: $r1
  
    $r0 = MOV_ri 0
    $r0 = MOV_ri 100
    JMP %bb.3
  
  bb.2.entry:
    liveins: $r1
  
    JMP %bb.4
  
  bb.3.pad1:
    liveins: $r1
  
    $r0 = MOV_ri 1
