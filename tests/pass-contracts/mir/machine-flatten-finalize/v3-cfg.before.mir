--- |
  source_filename = "machine-finalize-v3-cfg.ll"
  target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
  target triple = "bpfel"
  
  define i64 @flattened(i64 %value) #0 !bpf.capsule.flattened.units !0 {
  entry:
    br label %loop.head
  
  loop.head:                                        ; preds = %loop.tail, %entry
    br label %loop.tail
  
  loop.tail:                                        ; preds = %loop.head
    %again = icmp ne i64 %value, 0
    br i1 %again, label %loop.head, label %redundant
  
  redundant:                                        ; preds = %loop.tail
    br label %exit
  
  exit:                                             ; preds = %redundant
    ret i64 %value
  }
  
  attributes #0 = { "target-cpu"="v3" }
  
  !0 = !{i32 1}
...
---
name:            flattened
alignment:       8
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
liveins:
  - { reg: '$r1' }
frameInfo:
  maxAlignment:    1
  framePointerPolicy: none
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    liveins: $r1
  
  bb.1.loop.head:
    liveins: $r1
  
    $r0 = MOV_rr $r1
  
  bb.2.loop.tail:
    liveins: $r1
  
    JNE_ri $r1, 0, %bb.1
  
  bb.3.redundant:
    liveins: $r1
  
    JEQ_ri $r1, 0, %bb.4
  
  bb.4.exit:
    liveins: $r0
  
    RET implicit $r0
...
