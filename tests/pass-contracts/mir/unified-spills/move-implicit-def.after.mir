--- |
  source_filename = "unified-spills-move-implicit-def.ll"
  target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
  target triple = "bpfel"
  
  define i64 @physical(ptr %stack.base) !bpf.capsule.allocation.unit !0 !bpf.capsule.stack.size !1 {
  entry:
    ret i64 7
  }
  
  !0 = !{i32 0}
  !1 = !{i64 1024}
...
---
name:            physical
alignment:       8
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
liveins:
  - { reg: '$r1' }
frameInfo:
  stackSize:       40
  maxAlignment:    8
  adjustsStack:    true
  framePointerPolicy: none
  isCalleeSavedInfoValid: true
stack:
  - { id: 0, type: spill-slot, offset: -40, size: 8, alignment: 8 }
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    liveins: $r1
  
    STD $r1, $r10, -8
    INLINEASM &"# bpf_capsule_stack_anchor", sideeffect attdialect, reguse:GPR, $r1
    $w2 = MOV_ri_32 0
    $w3 = MOV_ri_32 7
    $w2 = MOV_rr_32 killed $w3, implicit-def $r2
    $r1 = LDD $r10, -8
    STD $r2, $r1, 0
    $r0 = LDD $r10, -8
    $r0 = LDD $r0, 0
    $w0 = AND_ri_32 $w0, 7
    RET implicit $r0
...
