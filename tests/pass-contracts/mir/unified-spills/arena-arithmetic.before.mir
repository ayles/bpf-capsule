--- |
  source_filename = "unified-arena-repair.ll"
  target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
  target triple = "bpfel"
  
  define i64 @commuted_add(i64 %address, i64 %offset) {
  entry:
    ret i64 0
  }
  
  define i64 @pointer_difference(i64 %left, i64 %right) {
  entry:
    ret i64 0
  }
...
---
name:            commuted_add
alignment:       8
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
liveins:
  - { reg: '$r1' }
  - { reg: '$r2' }
frameInfo:
  maxAlignment:    1
  framePointerPolicy: none
  isCalleeSavedInfoValid: true
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    liveins: $r1, $r2
  
    $r1 = ADDR_SPACE_CAST $r1, 0, 1
    $r0 = MOV_rr $r2
    $r0 = ADD_rr killed $r0, killed $r1
    RET implicit $r0
...
---
name:            pointer_difference
alignment:       8
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
liveins:
  - { reg: '$r1' }
  - { reg: '$r2' }
frameInfo:
  maxAlignment:    1
  framePointerPolicy: none
  isCalleeSavedInfoValid: true
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    liveins: $r1, $r2
  
    $r1 = ADDR_SPACE_CAST $r1, 0, 1
    $r2 = ADDR_SPACE_CAST $r2, 0, 1
    $r1 = SUB_rr killed $r1, killed $r2
    $r0 = MOV_rr killed $r1
    RET implicit $r0
...
