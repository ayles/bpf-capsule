--- |
  source_filename = "unified-spills-path-merge.ll"
  target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
  target triple = "bpfel"
  
  define i64 @physical(ptr %stack.base, i64 %condition) !bpf.capsule.allocation.unit !0 !bpf.capsule.stack.size !1 {
  entry:
    ret i64 0
  }
  
  !0 = !{i32 0}
  !1 = !{i64 1024}
...
---
name:            physical
alignment:       8
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
liveins:
  - { reg: '$r1' }
  - { reg: '$r2' }
frameInfo:
  stackSize:       40
  maxAlignment:    8
  adjustsStack:    true
  framePointerPolicy: none
  isCalleeSavedInfoValid: true
stack:
  - { id: 0, type: spill-slot, offset: -40, size: 8, alignment: 8 }
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2
  
    INLINEASM &"# bpf_capsule_stack_anchor", sideeffect attdialect, reguse:GPR, $r1
    JEQ_ri $r2, 0, %bb.2
    JMP %bb.1
  
  bb.1:
    liveins: $r2
  
    STD $r2, $r10, -40
    JMP %bb.3
  
  bb.2:
    JMP %bb.3
  
  bb.3:
    $r0 = LDD $r10, -40
    RET implicit $r0
...
