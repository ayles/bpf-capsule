--- |
  source_filename = "unified-spills.ll"
  target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
  target triple = "bpfel"
  
  declare i64 @callee(i64, i64, i64, i64, i64)
  
  define i64 @physical(ptr %input, ptr %stack.base) !bpf.capsule.allocation.unit !0 !bpf.capsule.stack.size !1 !bpf.capsule.spill.plan !2 {
  entry:
    call void asm sideeffect "# bpf_capsule_stack_anchor", "r"(ptr %stack.base)
    %p0 = getelementptr i64, ptr %input, i64 0
    %p1 = getelementptr i64, ptr %input, i64 1
    %p2 = getelementptr i64, ptr %input, i64 2
    %p3 = getelementptr i64, ptr %input, i64 3
    %v0 = load i64, ptr %p0, align 8
    %v1 = load i64, ptr %p1, align 8
    %v2 = load i64, ptr %p2, align 8
    %v3 = load i64, ptr %p3, align 8
    %called = call i64 @callee(i64 %v0, i64 0, i64 0, i64 0, i64 0)
    %narrow = trunc i64 %v1 to i32
    %wide = zext i32 %narrow to i64
    %a = add i64 %called, %wide
    %b = add i64 %a, %v2
    %result = add i64 %b, %v3
    ret i64 %result
  }
  
  !0 = !{i32 0}
  !1 = !{i64 1024}
  !2 = !{!3, !5, !6}
  !3 = !{i32 0, !4}
  !4 = !{i32 0, i64 -1}
  !5 = !{i32 1, !4}
  !6 = !{i32 2, !4}
...
---
name:            physical
alignment:       8
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
tracksDebugUserValues: true
liveins:
  - { reg: '$r1' }
  - { reg: '$r2' }
frameInfo:
  stackSize:       24
  maxAlignment:    8
  adjustsStack:    true
  hasCalls:        true
  framePointerPolicy: none
  maxCallFrameSize: 0
  isCalleeSavedInfoValid: true
stack:
  - { id: 0, type: spill-slot, offset: -8, size: 8, alignment: 8 }
  - { id: 1, type: spill-slot, offset: -16, size: 8, alignment: 8 }
  - { id: 2, type: spill-slot, offset: -24, size: 8, alignment: 8 }
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    liveins: $r1, $r2
  
    STD $r2, $r10, -8
    INLINEASM &"# bpf_capsule_stack_anchor", sideeffect attdialect, reguse:GPR, killed $r2
    $r2 = LDD $r1, 8 :: (load (s64) from %ir.p1)
    $r3 = LDD $r10, -8
    STD $r2, $r3, 8
    $r2 = LDD $r1, 16 :: (load (s64) from %ir.p2)
    $r3 = LDD $r10, -8
    STD $r2, $r3, 16
    $r2 = LDD $r1, 24 :: (load (s64) from %ir.p3)
    $r3 = LDD $r10, -8
    STD $r2, $r3, 0
    $r1 = LDD killed $r1, 0 :: (load (s64) from %ir.p0)
    JAL @callee, csr, implicit $r11, implicit $r1, implicit-def $r11, implicit-def $r0
    $r1 = LDD $r10, -8
    $r1 = LDW $r1, 8
    $r0 = ADD_rr killed $r0, killed $r1
    $r1 = LDD $r10, -8
    $r1 = LDD $r1, 16
    $r0 = ADD_rr killed $r0, killed $r1
    $r1 = LDD $r10, -8
    $r1 = LDD $r1, 0
    $r0 = ADD_rr killed $r0, killed $r1
    RET implicit $r0
...
