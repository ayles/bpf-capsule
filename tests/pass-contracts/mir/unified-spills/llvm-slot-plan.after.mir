--- |
  source_filename = "llvm-slot-plan.ll"
  target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
  target triple = "bpfel"
  
  define i64 @physical(ptr "bpf.capsule.borrowed" %ctx, ptr addrspace(1) %arena, i64 %scalar, ptr %native) !bpf.capsule.allocation.unit !0 !bpf.capsule.spill.plan !1 {
    ret i64 0
  }
  
  !0 = !{i32 0}
  !1 = !{!2, !4, !6, !8, !9, !11, !12}
  !2 = !{i32 1, !3}
  !3 = !{i32 1, i64 0}
  !4 = !{i32 2, !5}
  !5 = !{i32 0, i64 -1}
  !6 = !{i32 3, !7}
  !7 = !{i32 0, i64 65520}
  !8 = !{i32 5, !5}
  !9 = !{i32 7, !10}
  !10 = !{i32 0, i64 4294967295}
  !11 = !{i32 8, !5}
  !12 = !{i32 9, !10}
...
---
name:            physical
alignment:       1
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         false
hasFakeUses:     false
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
  - { id: 2, class: gpr }
  - { id: 3, class: gpr }
  - { id: 4, class: gpr }
  - { id: 5, class: gpr }
  - { id: 6, class: gpr }
  - { id: 7, class: gpr }
  - { id: 8, class: gpr }
  - { id: 9, class: gpr }
  - { id: 10, class: gpr }
  - { id: 11, class: gpr }
  - { id: 12, class: gpr32 }
  - { id: 13, class: gpr }
liveins:
  - { reg: '$r1', virtual-reg: '%0' }
  - { reg: '$r2', virtual-reg: '%1' }
  - { reg: '$r3', virtual-reg: '%2' }
  - { reg: '$r4', virtual-reg: '%3' }
frameInfo:
  maxAlignment:    8
  framePointerPolicy: none
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
  - { id: 1, type: spill-slot, size: 8, alignment: 8 }
  - { id: 2, type: spill-slot, size: 8, alignment: 8 }
  - { id: 3, type: spill-slot, size: 8, alignment: 8 }
  - { id: 4, type: spill-slot, size: 8, alignment: 8 }
  - { id: 5, type: spill-slot, size: 8, alignment: 8 }
  - { id: 6, type: spill-slot, size: 8, alignment: 8 }
  - { id: 7, type: spill-slot, size: 4, alignment: 4 }
  - { id: 8, type: spill-slot, size: 8, alignment: 8 }
  - { id: 9, type: spill-slot, size: 8, alignment: 8 }
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r1, $r2, $r3, $r4
  
    %0:gpr = COPY $r1
    %1:gpr = COPY $r2
    %2:gpr = COPY $r3
    %3:gpr = COPY $r4
    STD %3, %stack.0, 0 :: (store (s64) into %stack.0)
    STD %1, %stack.1, 0 :: (store (s64) into %stack.1)
    STD %2, %stack.2, 0 :: (store (s64) into %stack.2)
    %4:gpr = AND_ri %2, 65520
    STD %4, %stack.3, 0 :: (store (s64) into %stack.3)
    %5:gpr = LDD %0, 0 :: (load (s64) from %ir.ctx)
    STD %5, %stack.4, 0 :: (store (s64) into %stack.4)
    %6:gpr = LDD %1, 0 :: (load (s64) from %ir.arena, addrspace 1)
    INLINEASM &"", sideeffect attdialect, regdef:GPR, def %7, reguse tiedto:$0, %6(tied-def 3)
    STD %7, %stack.5, 0 :: (store (s64) into %stack.5)
    INLINEASM &"", sideeffect attdialect, regdef:GPR, def %8
    STD %8, %stack.6, 0 :: (store (s64) into %stack.6)
    %12:gpr32 = LDW32 %1, 8 :: (load (s32) from %ir.arena + 8, addrspace 1)
    STW32 %12, %stack.7, 0 :: (store (s32) into %stack.7)
    %11:gpr = LDWSX %1, 12 :: (load (s32) from %ir.arena + 12, addrspace 1)
    STD %11, %stack.8, 0 :: (store (s64) into %stack.8)
    %13:gpr = LDW %1, 8 :: (load (s32) from %ir.arena + 8, addrspace 1)
    STD %13, %stack.9, 0 :: (store (s64) into %stack.9)
    %9:gpr = LDD %stack.3, 0 :: (load (s64) from %stack.3)
    %10:gpr = COPY %9
    STD %10, %stack.3, 0 :: (store (s64) into %stack.3)
    $r0 = COPY %10
    RET implicit $r0
...
