# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(PkgConfig)
pkg_check_modules(LibBpf libbpf>=1.4.0 REQUIRED IMPORTED_TARGET)

include("${CMAKE_CURRENT_LIST_DIR}/BpfCapsuleTargets.cmake")

set(BPF_CAPSULE_CC_TARGET BpfCapsule::cc)
set(BPF_CAPSULE_LD_TARGET BpfCapsule::ld)
set(BPF_CAPSULE_LIBBPF_TARGET PkgConfig::LibBpf)
set(BPF_CAPSULE_LLVM_MAJOR "@LLVM_VERSION_MAJOR@")
set_and_check(BPF_CAPSULE_INCLUDE_DIR "@PACKAGE_BPF_CAPSULE_INSTALL_INCLUDE_DIR@")
# The compiler/runtime object ABI. Private: only the SDK's own tests read it.
set_and_check(BPF_CAPSULE_INTERNAL_INCLUDE_DIR "@PACKAGE_BPF_CAPSULE_INSTALL_INTERNAL_INCLUDE_DIR@")
set_and_check(BPF_CAPSULE_RUNTIME_DIR "@PACKAGE_BPF_CAPSULE_INSTALL_RUNTIME_DIR@")
set_and_check(BPF_CAPSULE_LIBC_DIR "@PACKAGE_BPF_CAPSULE_INSTALL_LIBC_DIR@")
set_and_check(BPF_CAPSULE_TLSF_DIR "@PACKAGE_BPF_CAPSULE_INSTALL_TLSF_DIR@")
set_and_check(BPF_CAPSULE_RUST_RUNTIME_DIR "@PACKAGE_BPF_CAPSULE_INSTALL_RUST_RUNTIME_DIR@")

include("${CMAKE_CURRENT_LIST_DIR}/BpfCapsule.cmake")
check_required_components(BpfCapsule)
